# Server
PORT=5000
NODE_ENV=development

# MongoDB
MONGO_URI=mongodb://localhost:27017/wmis_agl

# JWT
JWT_SECRET=your_super_secret_jwt_key_change_in_production_min_32_chars
JWT_EXPIRES_IN=15m
REFRESH_TOKEN_SECRET=your_refresh_token_secret_change_in_production_min_32_chars
REFRESH_TOKEN_EXPIRES_IN=7d

# Seed account passwords (set unique values of at least 8 characters before running npm run seed)
SEED_ADMIN_PASSWORD=
SEED_MANAGER_PASSWORD=
SEED_STOREKEEPER_PASSWORD=

# Client URL (for CORS)
CLIENT_URL=http://localhost:5173

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
LOGIN_RATE_LIMIT_MAX=5
